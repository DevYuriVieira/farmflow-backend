{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://farmflow.com/contracts/events/telemetry-alert-raised-v1.json",
  "title": "TelemetryAlertRaisedEvent",
  "description": "CloudEvents schema for telemetry threshold alert events in FarmFlow IoT Ingestion",
  "type": "object",
  "required": ["id", "source", "type", "specversion", "time", "tenantId", "correlationId", "data"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "type": {
      "type": "string",
      "const": "com.farmflow.telemetry.alert.raised.v1"
    },
    "specversion": {
      "type": "string",
      "const": "1.0"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "required": ["readingId", "farmId", "sensorId", "telemetryType", "value", "unit", "severity", "alertReason", "observedAt"],
      "properties": {
        "readingId": {
          "type": "string",
          "minLength": 1
        },
        "farmId": {
          "type": "string",
          "minLength": 1
        },
        "plantationId": {
          "type": ["string", "null"]
        },
        "sensorId": {
          "type": "string",
          "minLength": 1
        },
        "telemetryType": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
        },
        "alertReason": {
          "type": "string",
          "minLength": 1
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
